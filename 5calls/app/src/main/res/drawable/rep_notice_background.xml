<?xml version="1.0" encoding="utf-8"?>
<!-- Yellow box with a darker left edge, like the warning notice on the website. -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape android:shape="rectangle">
            <solid android:color="@color/rep_notice_accent" />
        </shape>
    </item>
    <item android:left="3dp">
        <shape android:shape="rectangle">
            <solid android:color="@color/rep_notice_background" />
        </shape>
    </item>
</layer-list>
